NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_PIN=
# Required outside demo mode. Do not reuse ADMIN_PIN as this value.
ADMIN_SESSION_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# Temporary live-demo switch. Server-only — never NEXT_PUBLIC_.
# Unset + ADMIN_PIN set = PIN required (secure default).
# Unset + ADMIN_PIN empty = demo mode (admin opens, banner shown).
# DEMO_OPEN_ADMIN=1 = force demo even if ADMIN_PIN is set.
# DEMO_OPEN_ADMIN=
